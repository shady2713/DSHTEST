{
  "name": "dshtest-plugin-development",
  "version": "0.0.0",
  "private": true,
  "description": "Development entry points for the independent DSH Web testing plugin.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "typecheck": "pnpm --dir dsh-plugin-web-test run typecheck",
