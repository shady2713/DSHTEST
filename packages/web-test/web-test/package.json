{
  "name": "@deepseek-ai/dsh-web-test",
  "description": "Web testing application identity and declared entry metadata",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web-test/web-test"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./recovery": {
      "types": "./lib/types/recovery-entry.d.ts",
      "default": "./lib/recovery-entry.js"
    },
    "./prototype": {
      "types": "./lib/types/prototype-entry.d.ts",
      "default": "./lib/prototype-entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/scope-provider.js",
    "lib/assembly.js",
    "lib/recovery-entry.js",
    "lib/prototype-entry.js",
    "web-test.cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "!lib/types/browser-automation-provider.d.ts",
    "!lib/types/browser-automation-provider.d.ts.map",
    "!lib/types/browser-automation-provider.js",
    "!lib/types/browser-automation-provider.js.map",
    "!lib/browser-automation-provider.js",
    "!lib/index.mjs",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-web-test-policy": "workspace:*",
    "@deepseek-ai/dsh-web-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-web-test-models": "workspace:*",
    "@deepseek-ai/dsh-web-test-conversation": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-ptc-runtime-quickjs": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-web-test-policy": "workspace:*",
    "@deepseek-ai/dsh-web-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-web-test-models": "workspace:*",
    "@deepseek-ai/dsh-web-test-conversation": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@deepseek-ai/dsh-loader-smoke": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  }
}
